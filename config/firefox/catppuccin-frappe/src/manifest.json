      "sidebar": "#292c3c",
      "sidebar_text": "#c6d0f5",
      "sidebar_border": "#414559",
      "sidebar_highlight": "#ca9ee6",
      "sidebar_highlight_text": "#232634",
      "ntp_background": "#303446",
      "ntp_text": "#c6d0f5",
      "input_background": "#292c3c",

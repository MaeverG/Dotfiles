{
  "manifest_version": 2,
  "name": "Catppuccin Frappe",
  "version": "1.0",
  "description": "Catppuccin Frappe (mauve accent) theme.",
  "browser_specific_settings": { "gecko": { "id": "catppuccin-frappe-mauve@local" } },
  "theme": {
    "colors": {
      "frame": "#232634",
      "frame_inactive": "#232634",
      "tab_background_text": "#a5adce",
      "tab_selected": "#303446",
      "tab_text": "#c6d0f5",
      "tab_line": "#ca9ee6",
      "tab_loading": "#ca9ee6",
      "toolbar": "#303446",
      "toolbar_text": "#c6d0f5",
      "bookmark_text": "#c6d0f5",
      "toolbar_field": "#292c3c",
